node_modules/
dist/
build/
*.tsbuildinfo

# Test + AI artifacts
# Root-anchored on purpose: an unanchored `artifacts/` matches a directory of
# that name at ANY depth, which silently excluded
# packages/execution-engine/src/artifacts/ — real source, exporting from the
# package index, so a fresh clone would not have compiled. Only the output
# directory at the repo root is meant to be ignored.
/artifacts/
playwright-report/
test-results/
blob-report/
.llm-cache/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.log

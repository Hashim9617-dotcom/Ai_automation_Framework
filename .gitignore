node_modules/
dist/
build/
*.tsbuildinfo

# Test + AI artifacts
# Root-anchored on purpose: an unanchored `artifacts/` matches a directory of
# that name at ANY depth, which silently excluded
# packages/execution-engine/src/artifacts/ — real source, exporting from the
# package index, so a fresh clone would not have compiled. Only the output
# directory at the repo root is meant to be ignored.
/artifacts/
playwright-report/
test-results/
blob-report/
.llm-cache/

# One-shot scripts: mutation harnesses, probes, measurement throwaways.
#
# They have a home so they stop landing at the repo root with a leading dot and
# being cleaned up by hand — five accumulated that way in one session, and each
# was removed by remembering to. Root-anchored for the same reason `/artifacts/`
# is: an unanchored `scratch/` matches a directory of that name at any depth.
/scratch/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Credential dumps. A real one appeared at the repo root on 2026-10-21 —
# "postgresql password.txt", 32 bytes, UNIGNORED — and `git add -A` would have
# committed it. It was caught by looking, which works until the once it does not.
#
# These patterns cover the shapes a credential arrives in: a note someone saved,
# a key file, a cloud-provider dump. They are NOT a control on their own —
# `git add -f` bypasses an ignore rule, and a rule nobody checks is a rule that
# has quietly stopped applying — so `tests/unit/credential-files.spec.ts` is the
# half that fails loudly. Same pairing as the workbook rules below.
*password*.txt
*password*.json
*passwords*
*secret*.txt
*secret*.json
*credential*.txt
*credential*.json
*.pem
*.key
*.pfx
*.p12
*.jks
*.keystore
id_rsa
id_ed25519
.pgpass
# Exceptions: these are code and documentation, not credentials. Narrow on
# purpose — a broad `!*.ts` would re-admit a file called `my-password.ts`.
!**/*.key.ts
!**/*.key.d.ts

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.log

# QA test-case workbooks. The "Final Test cases" sheet carries live credentials
# in its Test Data column (measured: 12 cells, row 3 onward), so a workbook must
# never enter the repo. Enforced by tests/unit/no-workbooks.spec.ts as well —
# "we remembered not to commit it" is not a control.
*.xlsx
*.xlsm
*.xls
*.ods

# MAINTAINER MODE MARKER.
#
# Its presence makes the kit integrity check skip, with a visible banner. It is a
# FILE rather than an environment variable for ALLOW_WRITES's reason: a variable can
# be set by a shell profile, a CI step or an agent running a command, and none of
# those leave a trace anybody can check afterwards.
#
# Gitignored so it cannot travel in a clone or a `git archive`. `pnpm kit:release`
# asserts its absence from the built zip rather than trusting this line.
.aitp-maintainer

# LOCAL, PER-MACHINE CONFIGURATION — never committed, never shipped.
#
# `.aitp-local/notify.json` holds one QA's own folder path and their team's email
# addresses: facts about this machine and these people, not about the platform. It
# is deliberately OUTSIDE every locked kit prefix, so a QA editing it does not trip
# the integrity check, and gitignored so a project's recipient list cannot reach a
# repository by way of `git add`.
#
# It holds NO credential and cannot: nothing in the notification path sends mail. A
# run drops a file into a synced folder and a Power Automate flow owned by a person
# sends it under their own identity. `loadNotifyConfig` REFUSES a config carrying a
# secret-shaped key rather than trusting this paragraph.
.aitp-local/

node_modules/
dist/
build/
*.tsbuildinfo

# Test + AI artifacts
# Root-anchored on purpose: an unanchored `artifacts/` matches a directory of
# that name at ANY depth, which silently excluded
# packages/execution-engine/src/artifacts/ — real source, exporting from the
# package index, so a fresh clone would not have compiled. Only the output
# directory at the repo root is meant to be ignored.
/artifacts/
playwright-report/
test-results/
blob-report/
.llm-cache/

# One-shot scripts: mutation harnesses, probes, measurement throwaways.
#
# They have a home so they stop landing at the repo root with a leading dot and
# being cleaned up by hand — five accumulated that way in one session, and each
# was removed by remembering to. Root-anchored for the same reason `/artifacts/`
# is: an unanchored `scratch/` matches a directory of that name at any depth.
/scratch/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.log

# QA test-case workbooks. The "Final Test cases" sheet carries live credentials
# in its Test Data column (measured: 12 cells, row 3 onward), so a workbook must
# never enter the repo. Enforced by tests/unit/no-workbooks.spec.ts as well —
# "we remembered not to commit it" is not a control.
*.xlsx
*.xlsm
*.xls
*.ods

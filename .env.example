# ─── Copy to .env and fill in. Never commit .env. ───────────────────────────

# ─── Which application to test ──────────────────────────────────────────────
# local = the bundled demo app (no setup needed)
# app   = YOUR application, configured entirely by the variables below
TEST_ENV=local

# Point at any application — this is the only block you change to switch targets.
# BASE_URL=https://dmsuiv3.example.com
# API_BASE_URL=                      # defaults to BASE_URL if omitted
# APP_USERNAME=
# APP_PASSWORD=
# APP_USER2_USERNAME=                # optional second role
# APP_USER2_PASSWORD=

# If your app marks elements with something other than data-testid
# (e.g. data-test, data-qa, data-cy), name it here.
# TEST_ID_ATTRIBUTE=data-testid

# Optional overrides for any environment
# TEST_WORKERS=4
# TEST_RETRIES=1

# Reproducible generated test data (omit for random data every run)
TEST_DATA_SEED=20260817

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# LOG_FORMAT=json

# ─── Orchestration API ──────────────────────────────────────────────────────
API_PORT=3001
# CORS_ORIGIN=http://localhost:5173

# ─── AI layer (Phase 2) ─────────────────────────────────────────────────────
# Without a key the platform falls back to the mock gateway and still runs.
LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LLM_MODEL_REASONING=claude-sonnet-4-5
LLM_MODEL_FAST=claude-haiku-4-5
LLM_BUDGET_USD=2
LLM_MAX_CALLS=200
# LLM_CACHE=memory

# Root cause analysis (Phase 2)
# Distinct failures analyzed per run — cross-browser duplicates count as one.
RCA_MAX_FAILURES=20
# Set to false to stop the API running analysis automatically after a failed run.
RCA_AUTO=true

# ─── Email reporting ────────────────────────────────────────────────────────
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=AI Testing Platform <qa-automation@your-company.com>
# REPORT_RECIPIENTS=qa-team@your-company.com

# ─── Environment credentials referenced by config/env/*.json ────────────────
# QA_ADMIN_USER=
# QA_ADMIN_PASSWORD=
# STAGING_ADMIN_USER=
# STAGING_ADMIN_PASSWORD=
# STAGING_DB_HOST=
# STAGING_DB_NAME=
# STAGING_DB_USER=
# STAGING_DB_PASSWORD=

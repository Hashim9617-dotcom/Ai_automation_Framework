{
  "name": "ai-testing-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered test automation platform — Playwright execution engine with an AI layer for test generation, self-healing, DOM understanding and root cause analysis.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "node scripts/kit-check.mjs && playwright test",
    "test:ui": "node scripts/kit-check.mjs && playwright test --ui",
    "test:headed": "node scripts/kit-check.mjs && playwright test --headed",
    "test:smoke:live": "node scripts/kit-check.mjs && playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=api --grep @smoke",
    "test:regression": "node scripts/kit-check.mjs && playwright test --grep @regression",
    "test:api": "playwright test --project=api",
    "test:api:internal": "node scripts/test-api.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:demo": "node scripts/test-demo.mjs",
    "test:report": "playwright show-report artifacts/reports/html",
    "rca": "tsx scripts/analyze-failures.ts",
    "heal": "tsx scripts/heal.ts",
    "eval:healing": "tsx scripts/eval-healing.ts",
    "heal:review": "tsx scripts/heal-review.ts",
    "inspect": "node scripts/kit-check.mjs && tsx scripts/inspect-app.ts",
    "auth": "node scripts/kit-check.mjs && tsx scripts/auth-setup.ts",
    "test:trace": "playwright show-trace",
    "api:dev": "pnpm --filter @aitp/api start:dev",
    "api:build": "pnpm --filter @aitp/api build",
    "api:start": "pnpm --filter @aitp/api start:prod",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "clean": "rimraf artifacts dist **/dist **/tsconfig.tsbuildinfo",
    "prepare:browsers": "playwright install --with-deps chromium",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:demo && pnpm --filter @aitp/api build && pnpm check:api-deps && pnpm test:api:internal",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "eval:generation": "tsx scripts/eval-generation-fixture.ts",
    "triage": "node scripts/kit-check.mjs && tsx scripts/triage-sheet.ts",
    "run-sheet": "node scripts/kit-check.mjs && tsx scripts/run-sheet.ts",
    "smoke:generation": "tsx scripts/generation-smoke.ts",
    "generate:review": "tsx scripts/generate-review.ts",
    "check:api-deps": "node scripts/check-api-deps.mjs",
    "migrate:captures": "tsx scripts/migrate-captures.ts",
    "verify-entries": "node scripts/kit-check.mjs && tsx scripts/verify-entries.ts",
    "kit:manifest": "node scripts/kit-manifest.mjs",
    "kit:release": "node scripts/kit-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
